# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_*  -> bundled into browser code. Public by design. NO secrets here.
# Everything else -> server-only (Route Handlers / Server Components).
# ---------------------------------------------------------------------------

# ---- Public (browser) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# reCAPTCHA v3 site key registered in Firebase App Check (public)
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Set to "true" in local dev to talk to the Firebase Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Razorpay publishable key id (public). Safe for the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Server-only secrets (never prefix with NEXT_PUBLIC_) ----
# Which payment provider implementation to use (currently only "razorpay")
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay webhook (different from the key secret)
RAZORPAY_WEBHOOK_SECRET=

# Firebase Admin SDK. Leave client email / private key empty to use
# Application Default Credentials (Cloud Run, gcloud auth, emulators).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Admin SDK emulator hosts (only for local development with emulators)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
